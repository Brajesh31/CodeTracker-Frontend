# Copy to leetcode/.env.local and use the Firebase web app configuration
# for a development project. Values are intentionally blank.
# VITE_ variables are embedded in browser assets. They are public client
# configuration and must never contain service-account keys or private secrets.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
